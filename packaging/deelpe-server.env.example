# /etc/deelpe-server/env (0600), or .env next to docker-compose.yml
POSTGRES_PASSWORD=bitte-aendern
DEELPE_DATABASE_URL=postgres://deelpe:bitte-aendern@localhost/deelpe
# Names/addresses under which browsers and agents reach the server (certificate).
DEELPE_SERVER_NAMES=dlp.firma.local,10.0.0.10
DEELPE_DATA_DIR=/var/lib/deelpe-server
DEELPE_UI_ADDR=0.0.0.0:8443
DEELPE_AGENT_ADDR=0.0.0.0:8444
DEELPE_SYSLOG_ADDR=0.0.0.0:514
DEELPE_LOG=info,sqlx=warn
# Behind a reverse proxy (docs/INSTALL.md, section 1): the proxy has to pass
# `Host`, `X-Forwarded-Host` and `X-Forwarded-For` through. Without a real
# proxy in front, trust_proxy stays off — otherwise a header from the network
# would get around the lockout after failed attempts.
#DEELPE_TRUST_PROXY=true
# Dashboard without TLS of its own (only when the proxy takes that over).
#DEELPE_UI_HTTP=true
